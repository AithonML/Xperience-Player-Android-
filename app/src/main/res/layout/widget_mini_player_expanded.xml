<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_container"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="UseAppTint">

    <!-- Header Row: Brand Status + Ambient Mode Quick Launch Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_brand_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_brand_logo"
            android:tint="@android:color/system_accent1_200" />

        <TextView
            android:id="@+id/widget_status_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_now_playing_eyebrow"
            android:textAllCaps="true"
            android:textColor="@android:color/system_accent1_200"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/widget_btn_ambient"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/widget_bg_pill_tonal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/widget_btn_ambient_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_cd_ambient"
                android:src="@drawable/widget_ic_ambient"
                android:tint="@android:color/system_accent2_100" />

            <TextView
                android:id="@+id/widget_btn_ambient_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_ambient_label"
                android:textColor="@android:color/system_accent2_100"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Showcase: Large Rounded Cover + Track Info -->
    <LinearLayout
        android:id="@+id/widget_player_tap_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_artwork_frame"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/widget_bg_artwork_placeholder"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_artwork_placeholder_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_cd_album_art"
                android:src="@drawable/widget_ic_brand_logo"
                android:tint="@android:color/system_accent1_200" />

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_cd_album_art"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/widget_idle_title"
                android:textColor="@android:color/system_neutral1_50"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="@android:color/system_neutral2_200"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_track_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@android:color/system_neutral2_300"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Progress Bar + Timestamps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_time_zero"
            android:textColor="@android:color/system_neutral2_200"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="1000"
            android:progress="350"
            android:progressDrawable="@drawable/widget_progress_horizontal" />

        <TextView
            android:id="@+id/widget_time_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_time_zero"
            android:textColor="@android:color/system_neutral2_200"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Full Controls Bar: Favorite + Prev + Play/Pause + Next -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_favorite"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_bg_circle_btn"
            android:contentDescription="@string/widget_cd_favorite"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_favorite_border"
            android:tint="@android:color/system_neutral2_200" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_bg_pill_tonal"
                android:contentDescription="@string/widget_cd_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_skip_previous"
                android:tint="@android:color/system_accent2_100" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/widget_bg_pill_primary"
                android:contentDescription="@string/widget_cd_play_pause"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play"
                android:tint="@android:color/system_accent1_900" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_bg_pill_tonal"
                android:contentDescription="@string/widget_cd_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_skip_next"
                android:tint="@android:color/system_accent2_100" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
