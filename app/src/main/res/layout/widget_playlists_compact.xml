<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_container"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="UseAppTint">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_playlists_header_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_playlists_brand_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ic_brand_logo"
                android:tint="@android:color/system_accent1_200" />

            <TextView
                android:id="@+id/widget_playlists_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_playlists_header"
                android:textColor="@android:color/system_neutral1_50"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_bg_circle_btn"
            android:contentDescription="@string/widget_cd_refresh"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_refresh"
            android:tint="@android:color/system_accent1_200" />
    </LinearLayout>

    <!-- 2-Card Row -->
    <LinearLayout
        android:id="@+id/widget_playlists_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Slot 0 -->
        <LinearLayout
            android:id="@+id/widget_pl_card_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_card"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/widget_pl_art_frame_0"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/widget_bg_artwork_placeholder"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_pl_art_placeholder_0"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_playlist_art"
                    android:src="@drawable/widget_ic_playlist_play"
                    android:tint="@android:color/system_accent1_200" />

                <ImageView
                    android:id="@+id/widget_pl_art_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_playlist_art"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pl_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_preview_mix_1"
                    android:textColor="@android:color/system_neutral1_50"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_pl_subtitle_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="@string/widget_badge_made_for_you"
                    android:textColor="@android:color/system_neutral2_200"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/widget_pl_card_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_card"
            android:clipToOutline="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/widget_pl_art_frame_1"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/widget_bg_artwork_placeholder"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widget_pl_art_placeholder_1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_cd_playlist_art"
                    android:src="@drawable/widget_ic_playlist_play"
                    android:tint="@android:color/system_accent1_200" />

                <ImageView
                    android:id="@+id/widget_pl_art_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_cd_playlist_art"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_pl_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_preview_mix_2"
                    android:textColor="@android:color/system_neutral1_50"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_pl_subtitle_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="@string/widget_badge_liked"
                    android:textColor="@android:color/system_neutral2_200"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Graceful Empty State -->
    <LinearLayout
        android:id="@+id/widget_playlists_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_playlists_empty_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_music_note"
            android:tint="@android:color/system_accent1_200" />

        <TextView
            android:id="@+id/widget_playlists_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_playlists_empty_title"
            android:textColor="@android:color/system_neutral1_50"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_playlists_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_playlists_empty_subtitle"
            android:textColor="@android:color/system_neutral2_200"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
